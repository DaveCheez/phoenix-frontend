# Server-only Django API endpoint. Keep /api at the end.
NUXT_DJANGO_API_BASE=http://127.0.0.1:8000/api

# Public site URL and checkout controls.
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_CHECKOUT_ENABLED=false

# Browser-safe publishable key only. Never put a Stripe secret key in this app.
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Optional server-only Google Places configuration.
NUXT_GOOGLE_PLACES_API_KEY=
NUXT_GOOGLE_PLACES_PLACE_ID=ChIJ8_c21s8Ke0gRA_p2G3v4g3g
