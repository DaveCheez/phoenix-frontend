# Server-only Django API endpoint. Keep /api at the end.
NUXT_DJANGO_API_BASE=http://127.0.0.1:8000/api

# Public site URL and checkout controls. Keep checkout disabled until the
# server-side order and payment workflow has been deployed and tested.
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_CHECKOUT_ENABLED=false

# The publishable key is safe for the browser, but keep the Stripe secret key
# out of this frontend repository.
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# Legacy name supported temporarily; prefer the variable above.
NUXT_PUBLIC_STRIPE_PK=

# Server-only Google Places configuration.
NUXT_GOOGLE_PLACES_API_KEY=
NUXT_GOOGLE_PLACES_PLACE_ID=ChIJ8_c21s8Ke0gRA_p2G3v4g3g
